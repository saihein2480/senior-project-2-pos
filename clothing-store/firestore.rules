rules_version = '2';

// =============================================================================
// Firestore Security Rules - Clothing Store POS + Web Storefront
// =============================================================================
//
// Two apps share this database:
//   - pos-clothing-store/clothing-store  (staff POS; roles in users/{uid}.role)
//   - pos-clothing-store-web             (customer storefront)
//
// Every server route in both apps uses the Admin SDK, which bypasses these
// rules; each of those routes checks the caller's ID token itself. These rules
// therefore only govern what a BROWSER can do with the client SDK, and they
// are written against the actual browser reads and writes in both apps:
//
//   POS browser:        sale (transactions create, counters, stocks quantities),
//                       refunds/cancellations (management), notifications,
//                       loyalty updates on customers, per-user cart, settings.
//   Storefront browser: catalogue reads, own users/customers profile + cart,
//                       own orders/transactions/notifications, own
//                       shopperSignals. Orders, coupons, loyalty and refund or
//                       cancel requests all go through API routes.
//
// Things a client can no longer do (all were possible under the old draft):
//   - create an owner/manager/staff account or change its own role
//   - set its own loyaltyPoints, coupons, membership or emailVerified flag
//   - create orders, transactions, refunds or notifications as a customer
//   - read other customers' orders or notifications
//   - reset or rewind the receipt counter
//   - keep using the POS after being deactivated (isActive == false)
//
// NOT DEPLOYED BY THIS CHANGE. Test in the emulator / Rules Playground first:
//     firebase emulators:start --only firestore
//     firebase deploy --only firestore:rules
// The first owner account must be created in the Firebase console (Auth user +
// users/{uid} with role "owner"); no client can create one.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // The caller's role from their own users doc, or null. Repeated get()s of
    // the same document within one request are only charged once.
    function role() {
      return isSignedIn() && exists(userPath())
        ? get(userPath()).data.get('role', null)
        : null;
    }

    // Deactivated staff keep a valid ID token until it expires, so the flag is
    // checked on every request (the POS API does the same).
    function isActiveAccount() {
      return get(userPath()).data.get('isActive', true) != false;
    }

    function isOwner()      { return role() == 'owner' && isActiveAccount(); }
    function isManagement() { return role() in ['owner', 'manager'] && isActiveAccount(); }
    function isPosUser()    { return role() in ['owner', 'manager', 'staff'] && isActiveAccount(); }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The email Firebase Auth verified for this caller ('' if none).
    function authEmail() {
      return request.auth.token.get('email', '');
    }

    // Fields an update adds, removes or changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // `field` may only change to `allowed`.
    function unchangedOr(field, allowed) {
      return !(field in changedKeys()) || request.resource.data[field] == allowed;
    }

    // ---------------------------------------------------------------------
    // users - holds the role, so the most sensitive collection
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();

      // Self sign-up (POS register and storefront) can only create a customer.
      // Staff/managers are created by /api/staff (Admin SDK).
      allow create: if isSelf(uid)
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'phone', 'address', 'addressLine',
             'addressWard', 'customerType', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.get('uid', uid) == uid
        && request.resource.data.get('email', '') in [authEmail(), ''];

      // Own profile only. role, isActive, createdBy etc. are not in the list,
      // so they cannot change from a browser.
      allow update: if isSelf(uid)
        && changedKeys().hasOnly([
             'displayName', 'phone', 'address', 'addressLine', 'addressWard',
             'customerType', 'currentBranch', 'email', 'uid', 'updatedAt'])
        && unchangedOr('uid', uid)
        && unchangedOr('email', authEmail());

      // Deleting staff goes through /api/staff, which also removes the Auth user.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Catalogue - public read so the storefront works signed out
    // ---------------------------------------------------------------------
    match /stocks/{stockId} {
      allow read: if true;
      // Products are normally created/edited through /api/stocks.
      allow create: if isManagement();
      // Any POS role may move quantities (a sale takes stock, a refund or
      // cancellation puts it back); only management may change anything else.
      allow update: if isManagement()
        || (isPosUser() && changedKeys().hasOnly(['colorVariants', 'updatedAt']));
      allow delete: if isOwner();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isManagement();
      allow delete: if isOwner();
    }

    match /online_promotions/{promotionId} {
      allow read: if true;
      allow write: if isManagement();
    }

    // ---------------------------------------------------------------------
    // Sales
    // ---------------------------------------------------------------------
    match /transactions/{txnId} {
      // Customers read their own (purchases and notifications pages query
      // where customer.uid == their uid, which this rule can prove).
      allow read: if isPosUser()
        || (isSignedIn() && resource.data.customer.uid == request.auth.uid);

      // Walk-in sales from the POS. Online orders are written by the order
      // routes; cancel/refund requests by their API routes.
      allow create: if isPosUser();

      // Refund, cancel, approve, delivery status: Owner + Manager.
      allow update: if isManagement();
      allow delete: if isOwner();
    }

    match /onlineOrders/{orderId} {
      // Staff can already see the same customer details on transactions.
      allow read: if isPosUser()
        || (isSignedIn() && resource.data.customer.uid == request.auth.uid);
      // Created only by /api/mmpay/create-order and /api/transactions/create-cod.
      allow create: if false;
      allow update: if isManagement();
      allow delete: if isOwner();
    }

    match /refunds/{refundId} {
      allow read, create, update: if isManagement();
      allow delete: if isOwner();
    }

    // Receipt numbers. Only the transaction counter, only forwards by one.
    match /counters/{counterId} {
      allow read: if isPosUser();
      allow create: if isPosUser()
        && counterId == 'transactionCounter'
        && request.resource.data.keys().hasOnly(['count', 'lastUpdated'])
        && request.resource.data.count == 1;
      allow update: if isPosUser()
        && counterId == 'transactionCounter'
        && changedKeys().hasOnly(['count', 'lastUpdated'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // POS cart, one per signed-in POS user.
    match /carts/{uid} {
      allow read, write: if isPosUser() && isSelf(uid);
    }

    // ---------------------------------------------------------------------
    // Customers - PII, never world-readable
    // ---------------------------------------------------------------------

    // What a storefront customer may write on their own document: profile,
    // identity echo, and the cart. Loyalty (points, coupons, membership),
    // totals, Telegram link and emailVerified are server-only.
    function customerSelfFields() {
      return ['displayName', 'phone', 'address', 'addressLine', 'addressWard',
              'customerType', 'email', 'uid', 'updatedAt', 'isOnline',
              'cartItems', 'cartUpdatedAt'];
    }

    match /customers/{customerId} {
      allow get: if isPosUser() || isSelf(customerId);
      allow list: if isPosUser();

      // POS: all roles add customers and update loyalty after a sale.
      // Storefront: the first-sign-in record, with zeroed totals.
      allow create: if isPosUser()
        || (isSelf(customerId)
            && request.resource.data.keys().hasOnly(customerSelfFields().concat(
                 ['totalPurchases', 'totalSpent', 'receivables',
                  'customerSource', 'createdAt']))
            && request.resource.data.get('totalPurchases', 0) == 0
            && request.resource.data.get('totalSpent', 0) == 0
            && request.resource.data.get('receivables', 0) == 0
            && request.resource.data.get('customerSource', 'online') == 'online'
            && request.resource.data.get('isOnline', true) == true
            && request.resource.data.get('uid', customerId) == customerId
            && request.resource.data.get('email', '') in [authEmail(), '']);

      allow update: if isPosUser()
        || (isSelf(customerId)
            && changedKeys().hasOnly(customerSelfFields())
            && unchangedOr('uid', customerId)
            && unchangedOr('email', authEmail())
            && unchangedOr('isOnline', true));

      allow delete: if isOwner();
    }

    // Personal browsing history for recommendations; owner only.
    match /shopperSignals/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'views', 'searches', 'updatedAt'])
        && request.resource.data.get('uid', uid) == uid
        && request.resource.data.get('views', []).size() <= 50
        && request.resource.data.get('searches', []).size() <= 50;
    }

    match /loyalty/{doc=**} {
      allow read: if isPosUser();
      allow write: if isManagement();
    }

    // ---------------------------------------------------------------------
    // Financial data - management only (normally via /api/expenses)
    // ---------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read, create, update: if isManagement();
      allow delete: if isOwner();
    }

    match /expenseCategories/{categoryId} {
      allow read, write: if isManagement();
    }

    match /spendingMenus/{menuId} {
      allow read, write: if isManagement();
    }

    // ---------------------------------------------------------------------
    // Shops and settings - public read (storefront needs tax, rate, fee,
    // branches); writes normally via the POS API
    // ---------------------------------------------------------------------
    match /shops/{shopId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isManagement();
    }

    match /business_settings/{docId} {
      allow read: if true;
      allow write: if isManagement();
    }

    // ---------------------------------------------------------------------
    // Notifications - staff-facing ones have no userId; customer ones do
    // ---------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isPosUser()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      // POS creates both kinds; storefront ones come from API routes.
      allow create: if isPosUser();
      allow update: if isPosUser()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && changedKeys().hasOnly(['read', 'readAt']));
      // The notifications page (all POS roles) can clear entries.
      allow delete: if isPosUser();
    }

    // ---------------------------------------------------------------------
    // Server only (Admin SDK): email codes, Telegram tokens/carts/sessions
    // ---------------------------------------------------------------------
    match /emailVerificationCodes/{docId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Default deny. Anything not listed above is inaccessible from a client.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
